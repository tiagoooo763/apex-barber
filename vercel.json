{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://barbdash.vercel.app",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://barbdash.vercel.app",
      "permanent": false
    }
  ]
}
